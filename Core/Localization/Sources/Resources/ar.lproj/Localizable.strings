"quran.quarter.name" = "%1$@ %2$@";
// A verse number: %1$d is the ayah number, such as "Ayah 255". Translators may move the number.
"quran.ayah.number" = "آية %1$d";
// The page subtitle when two pages show side by side: %1$@ and %2$@ are the first and last localized page numbers and %3$@ is the localized juz number, such as "Pages 2–3, Juz' 1". Translators may reorder the placeholders.
