// A page reference: %@ is the localized page number, such as "Page 42".
"quran.page.name" = "Halaman %@";
// A page location: %1$@ is the name of the page's first surah and %2$@ is the localized page, such as "At-Tawbah, Page 200". Translators may reorder the placeholders.
